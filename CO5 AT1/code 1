print("Destination:", GOAL)
print("Maximum Moves:", MAX_MOVES)
print("Battery Capacity:", BATTERY_CAPACITY)
print("Movement:", "Up, Down, Left, Right")
print("Intended Action Probability:", INTENDED_PROBABILITY)
print("Exploration Strategy: Epsilon-Greedy")
print("Planning Algorithm: Value Iteration")

print("\nObstacles:")
print(OBSTACLES)

print("\nOptimal Policy:")
print()

for r in range(ROWS):

    row = []

    for c in range(COLS):

        state = (r, c)

        if state in OBSTACLES:
            row.append("####")

        elif state == START:
            row.append(" S  ")

        elif state == GOAL:
            row.append(" G  ")

        else:

            symbols = {
                "Up": " ↑  ",
                "Down": " ↓  ",
                "Left": " ←  ",
                "Right": " →  "
            }

            row.append(
                symbols[policy[state]]
            )

    print("".join(row))


random.seed(42)

path, total_reward, battery_used, reached_goal = simulate_robot(
    epsilon=0.0
)

