print("Karthik V")
import numpy as np

states = ["Sunny", "Cloudy", "Rainy"]
observations = ["Sunny", "Cloudy", "Rainy"]

transition_prob = np.array([
    [0.7, 0.2, 0.1],
    [0.3, 0.4, 0.3],
    [0.2, 0.3, 0.5]
])

emission_prob = np.array([
    [0.8, 0.15, 0.05],
    [0.15, 0.7, 0.15],
    [0.05, 0.20, 0.75]
])

initial_prob = np.array([0.5, 0.3, 0.2])

observation_sequence = ["Sunny", "Cloudy", "Rainy", "Rainy", "Cloudy"]

obs_index = [observations.index(obs) for obs in observation_sequence]

n_states = len(states)
n_observations = len(obs_index)

viterbi = np.zeros((n_states, n_observations))
backpointer = np.zeros((n_states, n_observations), dtype=int)

viterbi[:, 0] = initial_prob * emission_prob[:, obs_index[0]]

for t in range(1, n_observations):
    for current_state in range(n_states):
        probabilities = (
            viterbi[:, t - 1]
            * transition_prob[:, current_state]
            * emission_prob[current_state, obs_index[t]]
        )

        viterbi[current_state, t] = np.max(probabilities)
        backpointer[current_state, t] = np.argmax(probabilities)

best_last_state = np.argmax(viterbi[:, -1])

best_path = [best_last_state]

for t in range(n_observations - 1, 0, -1):
    best_last_state = backpointer[best_last_state, t]
    best_path.append(best_last_state)

best_path.reverse()

predicted_states = [states[i] for i in best_path]

print("Observed Sequence:")
print(observation_sequence)

print("\nPredicted Hidden Weather States:")
print(predicted_states)
