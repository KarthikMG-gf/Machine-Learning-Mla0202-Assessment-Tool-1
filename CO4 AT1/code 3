print("Karthik V")
import numpy as np
import matplotlib.pyplot as plt
import networkx as nx

image = np.array([
    [50, 52, 49, 51],
    [48, 200, 55, 53],
    [51, 54, 190, 50],
    [49, 52, 48, 51]
], dtype=float)

rows, cols = image.shape

graph = nx.Graph()

for i in range(rows):
    for j in range(cols):
        graph.add_node((i, j), value=image[i, j])

for i in range(rows):
    for j in range(cols):
        if i + 1 < rows:
            graph.add_edge((i, j), (i + 1, j))

        if j + 1 < cols:
            graph.add_edge((i, j), (i, j + 1))

updated_image = image.copy()

for i in range(rows):
    for j in range(cols):
        neighbors = list(graph.neighbors((i, j)))

        if neighbors:
            neighbor_values = [
                image[x][y] for x, y in neighbors
            ]

            updated_image[i][j] = (
                image[i][j] + sum(neighbor_values)
            ) / (len(neighbor_values) + 1)

print("Original Image:")
print(image.astype(int))

print("\nUpdated Image after One Iteration:")
print(updated_image.astype(int))

print("\nGraph Nodes:")
print(graph.nodes())

print("\nGraph Edges:")
print(list(graph.edges()))

plt.figure(figsize=(10, 4))

plt.subplot(1, 2, 1)
plt.imshow(image, cmap="gray", vmin=0, vmax=255)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1, 2, 2)
plt.imshow(updated_image, cmap="gray", vmin=0, vmax=255)
plt.title("Updated Image")
plt.axis("off")

plt.show()
