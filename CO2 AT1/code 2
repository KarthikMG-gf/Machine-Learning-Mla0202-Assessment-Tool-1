import pandas as pd
from sklearn.linear_model import LogisticRegression
data = {
    'Offer': [3, 2, 1, 3, 0],
    'Win': [2, 1, 0, 3, 1],
    'Spam': [1, 1, 0, 1, 0]
}

df = pd.DataFrame(data)

X = df[['Offer', 'Win']]
y = df['Spam']
model = LogisticRegression()
model.fit(X, y)
print("Linear Classification Model Constructed Successfully.")

print("Intercept:", model.intercept_[0])
print("Coefficient for Offer:", model.coef_[0][0])
print("Coefficient for Win:", model.coef_[0][1])
print("\nDecision Boundary Equation:")
print(f"{model.coef_[0][0]:.4f}*Offer + {model.coef_[0][1]:.4f}*Win + {model.intercept_[0]:.4f} = 0")

new_email = [[2, 1]]

prediction = model.predict(new_email)
probability = model.predict_proba(new_email)

print("Prediction:", prediction[0])
print("Probability:", probability)

if prediction[0] == 1:
    print("Email is Spam")
else:
    print("Email is Not Spam")
