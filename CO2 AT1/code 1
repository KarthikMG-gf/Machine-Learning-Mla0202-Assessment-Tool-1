import pandas as pd
from sklearn.linear_model import LinearRegression

data = {
    'Area': [1000, 1500, 800, 1200, 2000],
    'Bedrooms': [2, 3, 2, 3, 4],
    'Price': [50, 75, 40, 60, 90]
}
df = pd.DataFrame(data)
X = df[['Area', 'Bedrooms']]
y = df['Price']
model = LinearRegression()
model.fit(X, y)
print("Linear Regression Model Constructed Successfully.")

print("Intercept (β0):", model.intercept_)
print("Coefficient for Area (β1):", model.coef_[0])
print("Coefficient for Bedrooms (β2):", model.coef_[1])
print("\nRegression Equation:")
print(f"Price = {model.intercept_:.2f} + ({model.coef_[0]:.4f} × Area) + ({model.coef_[1]:.4f} × Bedrooms)")

print("Interpretation:")
print(f"β0 = {model.intercept_:.2f}: Base price when Area and Bedrooms are zero.")
print(f"β1 = {model.coef_[0]:.4f}: Each additional square foot increases the price by {model.coef_[0]:.4f} lakhs.")
print(f"β2 = {model.coef_[1]:.4f}: Each additional bedroom increases the price by {model.coef_[1]:.4f} lakhs.")
